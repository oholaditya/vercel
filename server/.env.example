# ---------------------------------------------------------------------------
# Vertex Home Hub - server configuration
# Copy to server/.env (or run `npm run setup`, which also generates secrets).
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# SQLite database file (created automatically). Use :memory: for throw-away runs.
DATABASE_PATH=./data/hub.db

# JWT signing secret - at least 32 random characters. Required in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=8h

# Comma-separated list of browser origins allowed to call the API (Vite dev server).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Users are synchronised from these values at every start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me-operator
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me-viewer

# Simulated devices (all sample devices use this adapter).
SIMULATION_ENABLED=true
SIMULATION_TICK_MS=2000
# A device is marked offline when no heartbeat arrives within this window.
HEARTBEAT_TIMEOUT_MS=15000

# QNX / external device bridge (NDJSON over TCP) - see docs/QNX_INTEGRATION.md
BRIDGE_ENABLED=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=7400
BRIDGE_TOKEN=
